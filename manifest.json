{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.3.0",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "homepage_url": "https://github.com/tanktangmold/label-print-enhancer",
  "permissions": [
    "storage",
    "webNavigation",
    "activeTab"
  ],
  "host_permissions": [
    "https://jpo-prd-tokyo-app-front.s3.ap-northeast-1.amazonaws.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
