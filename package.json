{
  "name": "label-print-enhancer",
  "version": "0.3.3",
  "description": "Chrome extension + web app that redraws shipping-label PDFs onto your label size so Chrome's print preview prints them right",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "vendor": "node tools/vendor.mjs",
    "fixtures": "node tools/make-fixtures.mjs",
    "sample": "node tools/make-sample.mjs",
    "icons": "node tools/make-icons.mjs",
    "e2e": "node tools/e2e.mjs",
    "e2e:web": "node tools/e2e-web.mjs",
    "pack": "node tools/pack.mjs",
    "pages:build": "node tools/build-pages.mjs",
    "pages:serve": "node tools/serve-pages.mjs",
    "pages:deploy": "node tools/deploy-pages.mjs",
    "e2e:visual": "node tools/e2e-visual.mjs",
    "e2e:profiles": "node tools/e2e-profiles.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tanktangmold/label-print-enhancer.git"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "subset-font": "^2.9.0"
  }
}
